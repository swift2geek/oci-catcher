# oci iam compartment list --query 'data[0]."compartment-id"' --raw-output
OCI_COMPARTMENT_ID=ocid1.tenancy.oc1..xxx
# oci network subnet list -c $OCI_COMPARTMENT_ID
OCI_SUBNET_ID=ocid1.subnet.oc1.eu-frankfurt-1.xxx
# oci compute image list -c $OCI_COMPARTMENT_ID --operating-system "Canonical Ubuntu" --operating-system-version 24.04 --shape VM.Standard.A1.Flex
OCI_IMAGE_ID=ocid1.image.oc1.eu-frankfurt-1.xxx
SSH_PUBLIC_KEY="ssh-ed25519 AAAA... user@host"

OCI_SHAPE=VM.Standard.A1.Flex
# Always Free с 15.06.2026: максимум 2 OCPU / 12 GB (PAYG: 4 / 24)
OCPUS=2
MEMORY_GB=12
BOOT_VOLUME_GB=50
DISPLAY_NAME=free-vps
# пусто = все AD региона; иначе список через запятую
AVAILABILITY_DOMAINS=
RETRY_INTERVAL=120
HEARTBEAT_HOURS=6

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
